#!/bin/bash
# 双击:一键启动整个 Agent(体检 → 控制台 → 自动开跑,崩溃自动重启)
# 之后在打开的网页里填现场模型信息,点「开始跑」即可。
cd "$(dirname "$0")" || exit 1
echo "=============================================="
echo " 湾区杯 AI 智能体解题赛 · 一键启动"
echo "=============================================="
./start.sh
echo
echo "----------------------------------------------"
echo "控制台已就绪。之后的操作都在网页上完成:"
echo "  1) 控制台 → 填模型 Base URL / Key / 模型名 / API 类型 → 保存配置"
echo "  2) 点「测试模型」「测试接口」确认连通"
echo "  3) 总览 → 「开始跑」"
echo
echo "本窗口可以直接关掉(Agent 在后台跑)。"
read -n 1 -s -r -p "按任意键关闭本窗口…"
