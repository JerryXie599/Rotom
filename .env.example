# ============================================================
#  Rotom 配置模板
#  复制成 .env 再填;也可以完全在网页控制台里改(推荐):
#     ./start.sh   →   打开 http://127.0.0.1:8799   →   「控制台」
# ============================================================

# ---- 平台适配器(tsec = TSec Benchmark;arena = NSSCTF 靶场;留空 = 原 CTF 平台)----
CONTEST_ADAPTER=tsec

# ---- 跑分平台(在 TSecBench 创建跑分任务后下发)----
BENCHMARK_BASE_URL=
BENCHMARK_TOKEN=

# ---- 靶场 VPN 联通预检(只在 VPN 内可达,别改成平台地址)----
VPN_CHECK_URL=http://10.0.100.58
# 平台下发的 .ovpn 文件(给 tools/vpn.sh 用,可选)
VPN_OVPN_FILE=

# ---- 模型(PI_BASE_URL 留空 = 直接用 pi 的 models.json 里已有的 provider)----
PI_PROVIDER=ds
PI_BASE_URL=
PI_API_KEY=
PI_MODEL=deepseek-flash
PI_API_TYPE=openai-completions

# ---- 容器名额(平台硬上限:同时最多 3 道题的容器开着)----
MAX_ACTIVE_CHALLENGES=3
QUESTION_SLICE_SECONDS=1800
ROTATE_COOLDOWN=60

# ---- 并发(不在赛场,额度/带宽都省着用)----
START_WORKERS=4
MIN_WORKERS=1
WORKERS_PER_QUESTION=2
MAX_HELPERS_PER_QUESTION=3

# ---- 单题节奏 ----
WORKER_TIMEOUT=900
TIMEOUT_ESCALATE=180
MAX_WORKER_TIMEOUT=1800
MAX_ATTEMPTS=0
QUICK_RETRY_DELAY=5
FAILED_RETRY_AFTER=600
POLL_INTERVAL=5
KB_NUDGE_STEPS=12
KB_AUTO_SEARCH=1
HINT_AFTER_ATTEMPTS=0

# ---- 总时长(0=不限;设了到点自动收工并关闭所有容器)----
ROUND_WINDOW_MINUTES=0
# ROUND_END_AT=18:00
STOP_SPAWN_BEFORE_END=120

# ---- 其它 ----
KEEP_RUNNING=1
MAX_LOG_MB=0
QUOTA_BACKOFF=900
NET_PROXY=direct
NET_ALLOW=
PI_API_KEY_VAR=
