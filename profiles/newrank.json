{
  "name": "newrank",
  "title": "2026 比武 · 新榜单",
  "description": "2026 全国网安比武人工智能攻防赛:Web 直接入口,题目票据一次性,由 harness 兑换成会话 Cookie;无容器名额轮换、无 VPN 预检。",
  "goal": "flags",
  "prompt_pack": "newrank",
  "connection_style": "ctf",
  "default_env_hint": "none",
  "dispatch": {
    "workers_per_question": 2,
    "max_helpers": 4
  },
  "containers": {
    "manage": false,
    "rotate": false,
    "vpn_gate": false
  },
  "playbooks": {
    "pentest": "pentest.md",
    "web": "web.md",
    "pwn": "pwn.md",
    "reverse": "reverse.md",
    "re": "reverse.md",
    "crypto": "crypto.md",
    "forensics": "forensics.md",
    "misc": "misc.md",
    "取证": "forensics.md",
    "逆向": "reverse.md",
    "密码": "crypto.md"
  },
  "system_prompt": "shared/system-ctf.md",
  "loop": {
    "mode": "window",
    "stop": [
      "goal_done",
      "platform_dead",
      "net_gone",
      "token_bad"
    ],
    "prompt_time_budget": true
  },
  "observer": {
    "mode": "steps",
    "kb_nudge_steps": 12
  }
}